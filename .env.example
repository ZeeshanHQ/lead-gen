# Copy to .env.local for local development, or add these in Vercel -> Project Settings -> Environment Variables.
# NEVER commit .env.local.

# ---- 1. Database (Required for Production on Vercel) ------------------------
# Local Development Default (embedded PostgreSQL stored in ./.data/pglite):
DATABASE_URL=pglite://./.data/pglite

# Production on Vercel -> Use your Supabase PostgreSQL Connection String (Session Pooler port 5432 or Direct):
# Note: All tables and initial niches are automatically migrated & seeded on first startup!
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ---- 2. Live Web Discovery & Search (Optional) ------------------------------
# Free Tavily API key (1,000 searches/mo free at https://tavily.com) for live web prospecting:
TAVILY_API_KEY=
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Optional Google Places API key:
PLACES_API_KEY=

# ---- 3. AI / LLM Extraction (Optional; deterministic rules run by default) --
# none | local | openai | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# ---- 4. Optional B2B Enrichment ---------------------------------------------
# none | apollo
ENRICHMENT_PROVIDER=none
ENRICHMENT_API_KEY=

# ---- 5. Google Sheets OAuth / Webhook (Optional) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets
SECRETS_ENCRYPTION_KEY=

# ---- 6. Safety & Budget Ceilings --------------------------------------------
MAX_RUN_COST=5
MAX_REQUESTS_RUN=500
